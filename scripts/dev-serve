#!/usr/bin/env bash
# Run this checkout's wosarcherd in place of the NixOS service, with the
# service's own configuration, so a change can be tried without a push, a
# rebuild, and a service restart.
#
#   scripts/dev-serve            build the web UI, then serve
#   scripts/dev-serve --no-web   serve with the web UI already in web/dist
#
# It reads the live wosarcher.service unit (environment and secrets file)
# and the lazy proxy socket named by $WOSARCHER_DEV_SOCKET (default
# wosarcher-proxy.socket; its address and port), stops that socket,
# wosarcher.socket, and the service, copies the service's profiles (with the
# stored default), provider entries, depth presets, hooks.toml, and
# auth.json into a dev data directory (auth.json on the
# first run only; the dev server keeps its own password after that), and runs
# `uv run wosarcherd serve` on the proxy socket's address and port, so
# https://wosarcher.<domain> reaches the dev server through nginx, and on
# the Unix socket <data>/api.sock for the `wosarcher` client (the export
# line to use it is printed). On exit the sockets are started again and the
# service comes back on the next request.
#
# The dev server works in $WOSARCHER_DEV_DATA (default
# ~/.local/state/wosarcher-dev), not in /var/lib/wosarcher. The service's
# runs and caches are copied in at every start, so the history is there;
# dev runs are not copied back. The service's data directory is readable by
# the service user alone, so the copies and a secrets file are read with
# sudo; the secrets file reaches the dev daemon's environment only. Secret
# files the copied configuration references and you cannot read are copied
# into <data>/secrets (mode 0600) for the session and removed on exit.
set -euo pipefail
cd "$(dirname "$0")/.."

service=wosarcher.service
socket=${WOSARCHER_DEV_SOCKET:-wosarcher-proxy.socket}
proxy=${socket%.socket}.service
service_data=/var/lib/wosarcher
data=${WOSARCHER_DEV_DATA:-"${XDG_STATE_HOME:-$HOME/.local/state}/wosarcher-dev"}

build_web=true
for arg in "$@"; do
  case "$arg" in
    --no-web) build_web=false ;;
    *) echo "usage: scripts/dev-serve [--no-web]" >&2; exit 2 ;;
  esac
done

if [[ $EUID -eq 0 ]]; then
  echo "dev-serve: run as your user, not root; it calls sudo where it needs it" >&2
  exit 2
fi
# `sudo` may be a doas shim, so no `sudo -v`.
sudo true

# --- What the service runs with ----------------------------------------------
# Environment=NAME=value NAME=value ... (values with spaces are quoted).
env_line=$(systemctl show "$service" -p Environment --value)
# EnvironmentFiles=/path (ignore_errors=no)
env_file=$(systemctl show "$service" -p EnvironmentFiles --value | sed -n 's/^\([^ ]*\) (.*$/\1/p' | head -n 1)
listen=$(systemctl show "$socket" -p Listen --value | sed -n 's/^\([^ ]*\) (Stream)$/\1/p')
[[ -n "$listen" ]] || { echo "no Listen on $socket" >&2; exit 1; }
host=${listen%:*}
port=${listen##*:}

# --- Dev data directory ------------------------------------------------------
mkdir -p "$data/config/wosarcher" "$data/share" "$data/cache"
chmod 700 "$data"
owner="$(id -u):$(id -g)"
# Profiles (with the module's .nix-managed manifest), provider entries, and
# depth presets follow the service's on every start; profiles and presets
# saved in a dev session do not survive a restart.
for dir in profiles providers depths; do
  rm -rf "${data:?}/config/wosarcher/$dir"
  if sudo test -d "$service_data/config/wosarcher/$dir"; then
    sudo rsync -a --chown="$owner" --include='*/' --include='*.toml' --include='.nix-managed' \
      --exclude='*' "$service_data/config/wosarcher/$dir/" "$data/config/wosarcher/$dir/"
  fi
done
# The stored default profile (`wosarcherd profile use`).
current="$data/config/wosarcher/current"
rm -f "$current"
if sudo test -f "$service_data/config/wosarcher/current"; then
  sudo cat "$service_data/config/wosarcher/current" > "$current"
fi
# The service's runs (history) and caches (pages, embeddings), copied in one
# way: dev runs stay in the dev directory and never reach the service.
sudo rsync -a --chown="$owner" "$service_data/share/" "$data/share/"
sudo rsync -a --chown="$owner" "$service_data/cache/" "$data/cache/"
# hooks.toml (run-end webhooks and commands) follows the service's on every
# start; none there means none here.
hooks="$data/config/wosarcher/hooks.toml"
rm -f "$hooks"
if sudo test -f "$service_data/config/wosarcher/hooks.toml"; then
  (umask 077; sudo cat "$service_data/config/wosarcher/hooks.toml" > "$hooks")
fi

# Secret files (`<x>_file = "/path"` in the copied entries, profiles, and
# hooks.toml) that only the service user can read, such as /run/secrets/*,
# are copied (mode 0600) into <data>/secrets, and the dev copies point at
# them. They are removed when this script exits. `<x>_command` secrets run
# as you and are left as they are.
secrets="$data/secrets"
rm -rf "$secrets"
trap 'rm -rf "$secrets"' EXIT
mapfile -t configs < <(find "$data/config/wosarcher" -name '*.toml' -type f)
if ((${#configs[@]})); then
  mapfile -t secret_paths < <(perl -ne 'print "$2\n" while /\b\w+_file\s*=\s*(["\x27])(\/[^"\x27]+)\1/g' "${configs[@]}" | sort -u)
  for path in "${secret_paths[@]}"; do
    [[ -r "$path" ]] && continue
    sudo test -f "$path" || continue
    mkdir -p -m 700 "$secrets"
    copy="$secrets/${path//\//_}"
    (umask 077; sudo cat "$path" > "$copy")
    OLD="$path" NEW="$copy" perl -pi -e 's/(["\x27])\Q$ENV{OLD}\E\1/$1$ENV{NEW}$1/g' "${configs[@]}"
  done
fi

# auth.json (password hash, session secret, tokens) is the dev server's own
# once it exists: set a dev password with
#   XDG_CONFIG_HOME=<data>/config uv run wosarcherd auth set-password
# The service's file seeds it on the first run only.
auth="$data/config/wosarcher/auth.json"
if [[ ! -f "$auth" ]] && sudo test -f "$service_data/config/wosarcher/auth.json"; then
  (umask 077; sudo cat "$service_data/config/wosarcher/auth.json" > "$auth")
fi

# --- Web UI ------------------------------------------------------------------
if $build_web; then
  pnpm --dir web build
fi
[[ -f web/dist/index.html ]] || { echo "web/dist/index.html missing; run without --no-web" >&2; exit 1; }

# --- Swap the service for this checkout --------------------------------------
# The service's own Unix socket would start the service on a connection.
api_socket=wosarcher.socket
sockets=("$socket")
if systemctl cat "$api_socket" >/dev/null 2>&1; then
  sockets+=("$api_socket")
fi

restore() {
  rm -rf "$secrets"
  echo "dev-serve: starting ${sockets[*]} again" >&2
  sudo systemctl start "${sockets[@]}" || true
}
trap restore EXIT

echo "dev-serve: stopping ${sockets[*]}, $proxy, $service" >&2
sudo systemctl stop "${sockets[@]}" "$proxy" "$service"

# The service's environment, then the secrets file. Secrets stay in this
# process and the daemon it starts; nothing is written to disk.
# The unit's PATH (Nix store tools only) is dropped: uv and sudo come from
# this shell.
user_path=$PATH
set -a
eval "export $env_line"
PATH=$user_path
if [[ -n "$env_file" ]]; then
  if [[ -r "$env_file" ]]; then
    # shellcheck disable=SC1090
    source "$env_file"
  else
    # shellcheck disable=SC1090
    source <(sudo cat "$env_file")
  fi
fi
export XDG_CONFIG_HOME="$data/config" XDG_DATA_HOME="$data/share" XDG_CACHE_HOME="$data/cache"
export WOSARCHER_SERVER__STATIC_DIR="$PWD/web/dist" PYTHONUNBUFFERED=1
set +a

echo "dev-serve: profile ${WOSARCHER_PROFILE:-<default>}, data $data, serving http://$host:$port" >&2
echo "dev-serve: for the client, run: export WOSARCHER_SOCKET=$data/api.sock" >&2
uv run wosarcherd serve --host "$host" --port "$port" --socket "$data/api.sock"
