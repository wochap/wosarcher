#!/usr/bin/env bash
# Run this checkout's wosarcher in place of the NixOS service, with the
# service's own configuration, so a change can be tried without a push, a
# rebuild, and a service restart.
#
#   scripts/dev-serve            build the web UI, then serve
#   scripts/dev-serve --no-web   serve with the web UI already in web/dist
#
# It reads the live wosarcher.service unit (environment and secrets file)
# and the lazy proxy socket named by $WOSARCHER_DEV_SOCKET (default
# wosarcher-proxy.socket; its address and port), stops the socket and the
# service, copies the Nix-managed profiles and auth.json into a dev data
# directory (auth.json on the first run only; the dev server keeps its own
# password after that), and runs `uv run wosarcher serve` on the socket's
# address and port, so https://wosarcher.<domain> reaches the dev server
# through nginx. On exit the socket is started again and the service comes
# back on the next request.
#
# The dev server works in $WOSARCHER_DEV_DATA (default
# ~/.local/state/wosarcher-dev), not in /var/lib/wosarcher. The service's
# runs and caches are copied in at every start, so the history is there;
# dev runs are not copied back. The developer must be in the wosarcher
# group (services.wosarcher.users) to read the service's files; sudo is
# needed only for systemctl and a secrets file the group cannot read.
set -euo pipefail
cd "$(dirname "$0")/.."

service=wosarcher.service
socket=${WOSARCHER_DEV_SOCKET:-wosarcher-proxy.socket}
proxy=${socket%.socket}.service
service_data=/var/lib/wosarcher
data=${WOSARCHER_DEV_DATA:-"${XDG_STATE_HOME:-$HOME/.local/state}/wosarcher-dev"}

build_web=true
for arg in "$@"; do
  case "$arg" in
    --no-web) build_web=false ;;
    *) echo "usage: scripts/dev-serve [--no-web]" >&2; exit 2 ;;
  esac
done

[[ -r "$service_data/config" ]] || { echo "cannot read $service_data; add your user to services.wosarcher.users" >&2; exit 1; }

# `sudo` may be a doas shim, so no `sudo -v`.
sudo true

# --- What the service runs with ----------------------------------------------
# Environment=NAME=value NAME=value ... (values with spaces are quoted).
env_line=$(systemctl show "$service" -p Environment --value)
# EnvironmentFiles=/path (ignore_errors=no)
env_file=$(systemctl show "$service" -p EnvironmentFiles --value | sed -n 's/^\([^ ]*\) (.*$/\1/p' | head -n 1)
listen=$(systemctl show "$socket" -p Listen --value | sed -n 's/^\([^ ]*\) (Stream)$/\1/p')
[[ -n "$listen" ]] || { echo "no Listen on $socket" >&2; exit 1; }
host=${listen%:*}
port=${listen##*:}

# --- Dev data directory ------------------------------------------------------
mkdir -p "$data/config/wosarcher/profiles" "$data/share" "$data/cache"
chmod 700 "$data"
rm -f "$data"/config/wosarcher/profiles/*.toml
cp "$service_data"/config/wosarcher/profiles/*.toml "$data/config/wosarcher/profiles/" 2>/dev/null || true
# The service's runs (history) and caches (pages, embeddings), copied in one
# way: dev runs stay in the dev directory and never reach the service.
rsync -a --no-group "$service_data/share/" "$data/share/"
rsync -a --no-group "$service_data/cache/" "$data/cache/"

# auth.json (password hash, session secret, tokens) is the dev server's own
# once it exists: set a dev password with
#   XDG_CONFIG_HOME=<data>/config uv run wosarcher auth set-password
# The service's file seeds it on the first run only.
auth="$data/config/wosarcher/auth.json"
if [[ ! -f "$auth" && -f "$service_data/config/wosarcher/auth.json" ]]; then
  (umask 077; cat "$service_data/config/wosarcher/auth.json" > "$auth")
fi

# --- Web UI ------------------------------------------------------------------
if $build_web; then
  pnpm --dir web build
fi
[[ -f web/dist/index.html ]] || { echo "web/dist/index.html missing; run without --no-web" >&2; exit 1; }

# --- Swap the service for this checkout --------------------------------------
restore() {
  echo "dev-serve: starting $socket again" >&2
  sudo systemctl start "$socket" || true
}
trap restore EXIT

echo "dev-serve: stopping $socket, $proxy, $service" >&2
sudo systemctl stop "$socket" "$proxy" "$service"

# The service's environment, then the secrets file. Secrets stay in this
# process; nothing is written to disk.
set -a
eval "export $env_line"
if [[ -n "$env_file" ]]; then
  if [[ -r "$env_file" ]]; then
    # shellcheck disable=SC1090
    source "$env_file"
  else
    # shellcheck disable=SC1090
    source <(sudo cat "$env_file")
  fi
fi
export XDG_CONFIG_HOME="$data/config" XDG_DATA_HOME="$data/share" XDG_CACHE_HOME="$data/cache"
export WOSARCHER_SERVER__STATIC_DIR="$PWD/web/dist" PYTHONUNBUFFERED=1
set +a

echo "dev-serve: profile ${WOSARCHER_PROFILE:-<default>}, data $data, serving http://$host:$port" >&2
uv run wosarcher serve --host "$host" --port "$port"
