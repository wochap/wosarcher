# Completes a command group: $1 is the group name, the rest its subcommands.
_wosarcher_group() {
  local group=$1 curcontext=$curcontext state line
  shift
  local -a subcommands=("$@")
  _arguments -C \
    '--help[show help]' \
    '1:command:->command' \
    '*::arg:->args'
  case $state in
    command)
      _describe -t commands "$group command" subcommands
      ;;
    args)
      (( $+functions[_wosarcher_${group}_${line[1]}] )) && _wosarcher_${group}_${line[1]}
      ;;
  esac
}

_wosarcher_profile() {
  # commands: profile
  local -a subcommands=(
    'list:list profiles with their source, entries, and description'
    'show:print a profile resolved by the daemon, secrets redacted'
  )
  _wosarcher_group profile $subcommands
}

_wosarcher_providers() {
  # commands: providers
  local -a subcommands=(
    'list:list provider entries by block'
  )
  _wosarcher_group providers $subcommands
}

_wosarcher_depth() {
  # commands: depth
  local -a subcommands=(
    'list:list depth presets'
    'show:print the values a preset runs with'
  )
  _wosarcher_group depth $subcommands
}

_wosarcher_tokens() {
  # commands: tokens
  local -a subcommands=(
    'new:create an API token and print it once'
    'list:list API tokens, masked'
    'revoke:revoke an API token'
  )
  _wosarcher_group tokens $subcommands
}

_wosarcher() {
  local curcontext=$curcontext state line
  local wosarcher_command=${(Q)words[1]}
  # commands: wosarcher
  local -a commands=(
    'run:research a query and print the report'
    'catalog:crawl a brief into a catalog of records, or draft a structure'
    'fork:copy a run up to a stage and run the rest again'
    'runs:list runs, newest first'
    'logs:print a run'\''s logged events'
    'cancel:cancel a queued or running run'
    'export:write a finished report as PDF or DOCX'
    'doctor:check the daemon'\''s providers'
    'profile:list and show configuration profiles'
    'providers:list the provider entries'
    'depth:list and show depth presets'
    'tokens:create, list, and revoke API tokens'
    'schema:print the JSON Schema of every contract type'
  )

  _arguments -C \
    '--help[show help]' \
    '1:command:->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'command' commands
      ;;
    args)
      (( $+functions[_wosarcher_${line[1]}] )) && _wosarcher_${line[1]}
      ;;
  esac
}

_wosarcher "$@"
