#compdef wosarcher
# zsh completion for the wosarcher client.
#
# scripts/check_completions.py compares this file with the Typer app, so it
# keeps a fixed shape:
#   - one function per command, `_wosarcher_<command>() {` (`_wosarcher_profile_show`
#     for a subcommand), holding one `_arguments` spec per line; a spec that
#     names a flag starts with `'--flag[`, `'*--flag[`, `'(...)--flag[`, or a
#     `{--a,--b}` brace form;
#   - command lists follow a `# commands: <group>` line and value lists a
#     `# values: <name>` line, as an array with one quoted `name:description`
#     or `name` entry per line, closed by a line holding only `)`.
# Run IDs, profiles, provider entries, and depth presets are asked from the
# daemon through the command being completed; when it fails, nothing is offered.

# Runs the wosarcher command on the line (so a wrapper's WOSARCHER_SOCKET
# applies), at most 2 seconds, silently; prints nothing on failure.
# `_wosarcher` sets wosarcher_command before `_arguments` shifts $words.
_wosarcher_query() {
  local -a cmd=(${wosarcher_command:-wosarcher} "$@")
  (( $+commands[timeout] )) && cmd=(timeout 2 $cmd)
  local out
  out=$($cmd 2>/dev/null) || return 1
  print -r -- $out
}

_wosarcher_run_ids() {
  local -a runs
  local line id query
  # `runs --json` prints one field per line; run_id and query sit at the
  # object's top level (4 spaces in).
  for line in ${(f)"$(_wosarcher_query runs --json --limit 50)"}; do
    case $line in
      ('    "run_id": '*)
        id=${${line#*: \"}%\",}
        ;;
      ('    "query": '*)
        query=${${line#*: \"}%\",}
        query=${${query//\\\"/\"}//\\\\/\\}
        [[ -n $id ]] && runs+=("${id}:${query//:/\\:}")
        id=
        ;;
    esac
  done
  _describe -t runs 'run' runs
}

_wosarcher_profile_names() {
  local -a profiles
  local line
  # `profile list`: a 2-character active marker, the name, then source and description.
  for line in ${(f)"$(_wosarcher_query profile list)"}; do
    line=${line[3,-1]}
    [[ -n $line ]] && profiles+=("${line%% *}:${${line#* }//:/\\:}")
  done
  _describe -t profiles 'profile' profiles
}

_wosarcher_depth_names() {
  local -a depths
  local line
  # `depth list`: the name, then the description.
  for line in ${(f)"$(_wosarcher_query depth list)"}; do
    [[ -n $line ]] && depths+=("${line%% *}:${${line#* }//:/\\:}")
  done
  _describe -t depths 'depth preset' depths
}

_wosarcher_blocks() {
  # values: blocks
  local -a blocks=(
    'search'
    'fetch'
    'prefilter'
    'score'
    'llm'
  )
  _describe -t blocks 'block' blocks "$@"
}

# `--use BLOCK=NAME`: the block names, then the typed block's entry names.
_wosarcher_use() {
  if compset -P '*='; then
    local block=${IPREFIX%=}
    local -a entries
    local line
    # `providers list --json`: each entry's fields sit 6 spaces in.
    for line in ${(f)"$(_wosarcher_query providers list --block $block --json)"}; do
      case $line in
        ('      "name": '*)
          entries+=(${${line#*: \"}%\",})
          ;;
      esac
    done
    _describe -t entries "$block entry" entries
  else
    _wosarcher_blocks -S =
  fi
}

