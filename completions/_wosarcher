}

_wosarcher_run() {
  _arguments \
    '*--attach[file, directory, or glob to attach]:file:_files' \
    '--sources[files, web, or both]:sources:_wosarcher_sources' \
    '--until[stop after this stage]:stage:_wosarcher_stages' \
    '--profile[profile to use]:profile:_wosarcher_profile_names' \
    '*--use[use this provider entry for one block]:block=entry:_wosarcher_use' \
    '--depth[depth preset]:depth:_wosarcher_depth_names' \
    '*--set[override one field]:dotted.key=value:' \
    '--tone[writing tone]:tone:_wosarcher_tones' \
    '--tone-instructions[extra tone instructions]:instructions:' \
    '--words[target report length in words]:words:' \
    '--language[report language]:language:' \
    '--citation-marker[citation marker]:marker:_wosarcher_markers' \
    '--reference-style[reference style]:style:_wosarcher_styles' \
    '--format[write a report or an answer]:format:_wosarcher_formats' \
    '--sub-queries[sub-queries to plan]:count:' \
    '--results-per-query[search results per query]:count:' \
    '--max-pages[pages to fetch at most]:count:' \
    '--passages-per-query[passages kept per query]:count:' \
    '--context-tokens[context token cap]:tokens:_wosarcher_budget' \
    '--gap-context-tokens[gap step context token budget]:tokens:_wosarcher_budget' \
    '--rounds[research rounds]:rounds:(1 2 3 4 5 6 7 8)' \
    '--queries-per-round[follow-up queries per round at most]:count:' \
    '--search-language[search language]:language:_wosarcher_search_language' \
    '*--allow-domain[only use search results from this domain]:domain:' \
    '*--block-domain[drop search results from this domain]:domain:' \
    '--model[chat model for this run]:model:' \
    '--context-window[the model'\''s context window in tokens]:tokens:' \
    '--max-output[the model'\''s output limit in tokens]:tokens:' \
    '--plan-thinking[thinking for the plan step]:level:_wosarcher_efforts' \
    '--gap-thinking[thinking for the gap step]:level:_wosarcher_efforts' \
    '--write-thinking[thinking for the write step]:level:_wosarcher_efforts' \
    '--json[print one JSON document when the run ends]' \
    '--help[show help]' \
    '1:query:'
}

